generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id             String   @id @default(cuid())
  username       String   @unique
  email          String   @unique
  passwordHash   String
  name           String
  profilePhoto   String?
  yearGroup      Int?
  borrowLimit    Int      @default(5)
  approved       Boolean  @default(true)
  paused         Boolean  @default(false)
  isAdmin        Boolean  @default(false)
  isTeacher      Boolean  @default(false)
  damagedReports Int      @default(0)
  nonReturns     Int      @default(0)
  createdAt      DateTime @default(now())

  parentId  String?
  parent    User?   @relation("ParentChildren", fields: [parentId], references: [id])
  children  User[]  @relation("ParentChildren")

  ownedBooks      Book[]
  swapRequests    SwapRequest[] @relation("BorrowerRequests")
  ratingsGiven    Rating[]      @relation("RatingsGiven")
  ratingsReceived Rating[]      @relation("RatingsReceived")
  bookRatings     BookRating[]
  messages        Message[]
  wishlist        WishlistItem[]
  notifications   Notification[]
  bookRequests    BookRequest[]
  queueEntries    QueueEntry[]
  readingLists    ReadingList[]
  consentRequest  ConsentRequest?
}

model ConsentRequest {
  id          String   @id @default(cuid())
  token       String   @unique
  parentEmail String
  status      String   @default("PENDING")
  createdAt   DateTime @default(now())
  expiresAt   DateTime

  childId String @unique
  child   User   @relation(fields: [childId], references: [id], onDelete: Cascade)
}

model Book {
  id                 String    @id @default(cuid())
  title              String
  author             String?
  series             String?
  seriesNumber       Int?
  condition          Condition
  labelType          LabelType @default(PERSONAL)
  tags               String    @default("[]")
  coverPhoto         String?
  genres             String    @default("[]")
  description        String?
  isAvailable        Boolean   @default(true)
  isCurrentlyReading Boolean   @default(false)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  owner           User            @relation(fields: [ownerId], references: [id])
  ownerId         String
  requests        SwapRequest[]
  wishlistedBy    WishlistItem[]
  queueEntries    QueueEntry[]
  bookRatings     BookRating[]
  readingListItems ReadingListItem[]
}

model BookRating {
  id        String   @id @default(cuid())
  stars     Int
  review    String?
  createdAt DateTime @default(now())

  book   Book   @relation(fields: [bookId], references: [id])
  bookId String
  user   User   @relation(fields: [userId], references: [id])
  userId String

  @@unique([bookId, userId])
}

model ReadingList {
  id            String   @id @default(cuid())
  name          String
  description   String?
  isPublic      Boolean  @default(false)
  isTeacherList Boolean  @default(false)
  createdAt     DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id])
  userId String

  items ReadingListItem[]
}

model ReadingListItem {
  id      String   @id @default(cuid())
  addedAt DateTime @default(now())

  list   ReadingList @relation(fields: [listId], references: [id])
  listId String
  book   Book        @relation(fields: [bookId], references: [id])
  bookId String

  @@unique([listId, bookId])
}

model BookRequest {
  id        String   @id @default(cuid())
  title     String
  author    String?
  fulfilled Boolean  @default(false)
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id])
  userId String
}

model QueueEntry {
  id        String      @id @default(cuid())
  position  Int
  status    QueueStatus @default(WAITING)
  note      String?
  createdAt DateTime    @default(now())

  book   Book   @relation(fields: [bookId], references: [id])
  bookId String
  user   User   @relation(fields: [userId], references: [id])
  userId String

  @@unique([bookId, userId])
}

model SwapRequest {
  id                  String        @id @default(cuid())
  requestedPickupDate DateTime
  requestedReturnDate DateTime?
  loanMode            LoanMode      @default(FIXED_DATE)
  status              RequestStatus @default(PENDING)
  counterPickupDate   DateTime?
  counterReturnDate   DateTime?
  counterLoanMode     LoanMode?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  book       Book   @relation(fields: [bookId], references: [id])
  bookId     String
  borrower   User   @relation("BorrowerRequests", fields: [borrowerId], references: [id])
  borrowerId String

  swap       Swap?
}

model Swap {
  id                      String    @id @default(cuid())
  pickupDate              DateTime
  returnDate              DateTime?
  loanMode                LoanMode  @default(FIXED_DATE)
  confirmedAt             DateTime  @default(now())
  handedOver              Boolean   @default(false)
  ownerConfirmedReturn    Boolean   @default(false)
  borrowerConfirmedReturn Boolean   @default(false)
  returnConfirmedAt       DateTime?

  request   SwapRequest @relation(fields: [requestId], references: [id])
  requestId String      @unique

  messages  Message[]
  ratings   Rating[]
}

model Message {
  id        String   @id @default(cuid())
  content   String
  createdAt DateTime @default(now())

  swap     Swap   @relation(fields: [swapId], references: [id])
  swapId   String
  sender   User   @relation(fields: [senderId], references: [id])
  senderId String
}

model Rating {
  id        String    @id @default(cuid())
  stars     Int
  review    String?
  role      RaterRole
  damaged   Boolean   @default(false)
  notReturned Boolean @default(false)
  createdAt DateTime  @default(now())

  swap    Swap   @relation(fields: [swapId], references: [id])
  swapId  String
  rater   User   @relation("RatingsGiven", fields: [raterId], references: [id])
  raterId String
  ratee   User   @relation("RatingsReceived", fields: [rateeId], references: [id])
  rateeId String

  @@unique([swapId, raterId])
}

model WishlistItem {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id])
  userId String
  book   Book   @relation(fields: [bookId], references: [id])
  bookId String

  @@unique([userId, bookId])
}

model Notification {
  id        String   @id @default(cuid())
  type      String
  message   String
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id])
  userId String
}

enum Condition {
  NEW
  MINOR_WEAR
  MAJOR_WEAR
  SEVERE_WEAR
}

enum LabelType {
  PERSONAL
  SCHOOL_PROPERTY
  DONATED
}

enum RequestStatus {
  PENDING
  ACCEPTED
  REJECTED
  COUNTER_PROPOSED
  COMPLETED
  CANCELLED
}

enum RaterRole {
  AS_OWNER
  AS_BORROWER
}

enum LoanMode {
  FIXED_DATE
  READ_TILL_FINISH
}

enum QueueStatus {
  WAITING
  OFFERED
  DECLINED
}
