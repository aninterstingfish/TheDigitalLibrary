generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id             String   @id @default(cuid())
  username       String   @unique
  email          String   @unique
  passwordHash   String
  name           String
  profilePhoto   String?
  yearGroup      Int?
  borrowLimit    Int      @default(5)
  createdAt      DateTime @default(now())

  ownedBooks      Book[]
  swapRequests    SwapRequest[] @relation("BorrowerRequests")
  ratingsGiven    Rating[]      @relation("RatingsGiven")
  ratingsReceived Rating[]      @relation("RatingsReceived")
  messages        Message[]
  wishlist        WishlistItem[]
}

model Book {
  id          String    @id @default(cuid())
  title       String
  author      String?
  condition   Condition
  coverPhoto  String?
  genres      String    @default("[]")
  description String?
  isAvailable Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  owner        User          @relation(fields: [ownerId], references: [id])
  ownerId      String
  requests     SwapRequest[]
  wishlistedBy WishlistItem[]
}

model SwapRequest {
  id                  String        @id @default(cuid())
  requestedPickupDate DateTime
  requestedReturnDate DateTime?
  loanMode            LoanMode      @default(FIXED_DATE)
  status              RequestStatus @default(PENDING)
  counterPickupDate   DateTime?
  counterReturnDate   DateTime?
  counterLoanMode     LoanMode?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  book       Book   @relation(fields: [bookId], references: [id])
  bookId     String
  borrower   User   @relation("BorrowerRequests", fields: [borrowerId], references: [id])
  borrowerId String

  swap       Swap?
}

model Swap {
  id                      String    @id @default(cuid())
  pickupDate              DateTime
  returnDate              DateTime?
  loanMode                LoanMode  @default(FIXED_DATE)
  confirmedAt             DateTime  @default(now())
  ownerConfirmedReturn    Boolean   @default(false)
  borrowerConfirmedReturn Boolean   @default(false)

  request    SwapRequest @relation(fields: [requestId], references: [id])
  requestId  String      @unique

  messages   Message[]
  ratings    Rating[]
}

model Message {
  id        String   @id @default(cuid())
  content   String
  createdAt DateTime @default(now())

  swap      Swap   @relation(fields: [swapId], references: [id])
  swapId    String
  sender    User   @relation(fields: [senderId], references: [id])
  senderId  String
}

model Rating {
  id        String    @id @default(cuid())
  stars     Int
  review    String?
  role      RaterRole
  createdAt DateTime  @default(now())

  swap      Swap   @relation(fields: [swapId], references: [id])
  swapId    String
  rater     User   @relation("RatingsGiven", fields: [raterId], references: [id])
  raterId   String
  ratee     User   @relation("RatingsReceived", fields: [rateeId], references: [id])
  rateeId   String

  @@unique([swapId, raterId])
}

model WishlistItem {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  user      User   @relation(fields: [userId], references: [id])
  userId    String
  book      Book   @relation(fields: [bookId], references: [id])
  bookId    String

  @@unique([userId, bookId])
}

enum Condition {
  NEW
  MINOR_WEAR
  MAJOR_WEAR
  SEVERE_WEAR
}

enum RequestStatus {
  PENDING
  ACCEPTED
  REJECTED
  COUNTER_PROPOSED
  COMPLETED
  CANCELLED
}

enum RaterRole {
  AS_OWNER
  AS_BORROWER
}

enum LoanMode {
  FIXED_DATE
  READ_TILL_FINISH
}
